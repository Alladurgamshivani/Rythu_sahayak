# Copy this file to .env for local development.
# For local SQLite, keep the DATABASE_URL line below.
DATABASE_URL=sqlite:///./rythu_sahayak.db
# For PostgreSQL with docker-compose.yml, use this instead:
# DATABASE_URL=postgresql+psycopg://rythu_user:rythu_local_password@localhost:5432/rythu_sahayak

DEMO_USERNAME=demo_officer
DEMO_PASSWORD=officer123
JWT_SECRET=replace_this_with_a_long_random_secret_before_deployment
TOKEN_EXPIRE_MINUTES=480
FRONTEND_ORIGIN=http://localhost:5173
OPENAI_API_KEY=OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini
